# Database
# For local development, run `npx prisma dev` to start a local PostgreSQL server
# For production, use a hosted PostgreSQL provider (Neon, Supabase, PlanetScale, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-min-32-chars-long"

# Sanity CMS (existing)
NEXT_PUBLIC_SANITY_PROJECT_ID="your-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN="your-sanity-api-token"

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
# Add callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# World ID (IDKit)
# Create at: https://developer.worldcoin.org
# 1. Create an app and select "External" integration type
# 2. Create an "incognito action" for sign-in
NEXT_PUBLIC_WORLDCOIN_APP_ID="app_xxxxxxxxxxxxx"
NEXT_PUBLIC_WORLDCOIN_ACTION_ID="your-action-id"
